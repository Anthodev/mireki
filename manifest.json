{
  "manifest_version": 3,
  "name": "Mireki",
  "version": "0.5.0",
  "description": "Displays current media playback and prepares Trakt scrobbling.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mireki@antho.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo"
        ]
      }
    }
  },
  "host_permissions": [
    "https://*.animationdigitalnetwork.com/*",
    "https://*.crunchyroll.com/*",
    "https://*.disneyplus.com/*",
    "https://*.hbomax.com/*",
    "https://*.hulu.com/*",
    "https://*.max.com/*",
    "https://*.netflix.com/*",
    "https://*.paramountplus.com/*",
    "https://*.peacocktv.com/*",
    "https://*.primevideo.com/*",
    "https://*.youtube.com/*",
    "https://*.youtube-nocookie.com/*",
    "https://tv.apple.com/*"
  ],
  "background": {
    "scripts": [
      "config/auth-config.js",
      "auth/token-store.js",
      "services/trakt-auth.js",
      "shared/artwork-url.js",
      "shared/session-store.js",
      "background/background.js",
      "background/auth-background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.animationdigitalnetwork.com/*",
        "https://*.crunchyroll.com/*",
        "https://*.disneyplus.com/*",
        "https://*.hbomax.com/*",
        "https://*.hulu.com/*",
        "https://*.max.com/*",
        "https://*.netflix.com/*",
        "https://*.paramountplus.com/*",
        "https://*.peacocktv.com/*",
        "https://*.primevideo.com/*",
        "https://*.youtube.com/*",
        "https://*.youtube-nocookie.com/*",
        "https://tv.apple.com/*"
      ],
      "all_frames": true,
      "js": [
        "shared/artwork-url.js",
        "playback/media-snapshot.js",
        "content/media-observer.js"
      ]
    }
  ],
  "icons": {
    "32": "icons/mireki.svg",
    "48": "icons/mireki.svg",
    "96": "icons/mireki.svg"
  },
  "action": {
    "default_icon": {
      "16": "icons/mireki.svg",
      "32": "icons/mireki.svg"
    },
    "default_title": "Mireki status",
    "default_popup": "popup/popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; img-src 'self' https:; connect-src https:; object-src 'none'"
  },
  "permissions": [
    "identity",
    "storage"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
