{
  "manifest_version": 3,
  "name": "Mireki",
  "version": "0.8.5",
  "description": "Displays current media playback and enables Trakt scrobbling.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mireki@antho.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "websiteActivity", "websiteContent"]
      }
    }
  },
  "host_permissions": [
    "https://*.crunchyroll.com/*",
    "https://*.netflix.com/*",
    "https://*.primevideo.com/*",
    "https://api.trakt.tv/*"
  ],
  "background": {
    "scripts": [
      "config/auth-config.js",
      "auth/token-store.js",
      "services/trakt-auth.js",
      "shared/artwork-url.js",
      "shared/episode-label.js",
      "shared/session-store.js",
      "trakt/trakt-client.js",
      "trakt/trakt-matcher.js",
      "playback/scrobble-controller.js",
      "background/auth-background.js",
      "background/scrobble-background.js",
      "background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://*.crunchyroll.com/*"],
      "all_frames": true,
      "js": [
        "shared/artwork-url.js",
        "playback/media-snapshot.js",
        "content/media-observer.js"
      ]
    },
    {
      "matches": ["https://*.primevideo.com/*"],
      "all_frames": true,
      "js": [
        "shared/artwork-url.js",
        "shared/episode-label.js",
        "playback/media-snapshot.js",
        "providers/prime-video.js",
        "content/media-observer.js"
      ]
    },
    {
      "matches": ["https://*.netflix.com/*"],
      "all_frames": true,
      "js": [
        "shared/artwork-url.js",
        "shared/episode-label.js",
        "playback/media-snapshot.js",
        "providers/netflix.js",
        "content/media-observer.js"
      ]
    }
  ],
  "icons": {
    "32": "icons/mireki.svg",
    "48": "icons/mireki.svg",
    "96": "icons/mireki.svg"
  },
  "action": {
    "default_icon": {
      "16": "icons/mireki.svg",
      "32": "icons/mireki.svg"
    },
    "default_title": "Mireki status",
    "default_popup": "popup/popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; img-src 'self' https:; connect-src https:; object-src 'none'"
  },
  "permissions": ["identity", "storage", "alarms"],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
